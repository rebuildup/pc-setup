# Secrets / local environment
.env
.env.*
!.env.example
*.pem
*.key

# Local scratch
.tmp/
.reference/

# Generated by `mise lock` next to the working tree it resolves from. The
# committed output of that command is mise.global.lock only; this repository
# keeps its configs at the root (mise.toml / mise.global.toml), so .mise/ holds
# derived per-tool lock state and nothing else.
.mise/

# Backups taken while editing a managed config; never part of the repository
*.backup-*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
