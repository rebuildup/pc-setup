# Secrets / local environment
.env
.env.*
!.env.example
*.pem
*.key

# Local scratch
.tmp/
.reference/

# Backups taken while editing a managed config; never part of the repository
*.backup-*

# Note: `.mise/` is deliberately NOT ignored. `mise lock` writes native
# dependency sidecars there, and mise requires them to be committed next to the
# lockfile for `mise install --locked` to work.

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
