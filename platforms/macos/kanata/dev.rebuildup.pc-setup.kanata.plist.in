<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.rebuildup.pc-setup.kanata</string>
  <key>ProgramArguments</key>
  <array>
    <string>__KANATA_BIN__</string>
    <string>--cfg</string>
    <string>__KANATA_CONFIG__</string>
  </array>
  <key>UserName</key>
  <string>root</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/var/log/pc-setup-kanata.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/pc-setup-kanata.log</string>
</dict>
</plist>
