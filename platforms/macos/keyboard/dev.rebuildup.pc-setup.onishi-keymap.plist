<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.rebuildup.pc-setup.onishi-keymap</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/pc-setup/macos-keyboard/apply-onishi.sh</string>
  </array>
  <key>UserName</key>
  <string>root</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- The helper runs for the life of the job because the Karabiner DriverKit
       virtual keyboard restores the Onishi mapping every time Kanata restarts.
       KeepAlive restarts it only after a failure so a successful exit does not
       create a restart loop. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ONISHI_WATCH_INTERVAL</key>
    <string>5</string>
  </dict>
  <!-- Not Background. A Background job is scheduled at low priority and macOS
       had deferred it until loginwindow came up, which repeatedly left the
       login screen on raw US ANSI in practice. Adaptive shifts between
       Background and Interactive based on activity, so the helper is not
       pinned to the Background tier and observes XPC traffic promptly.
       ProcessType is a resource classification, not a launch-order setting;
       the helper and the LaunchDaemon are loaded at boot, but launchd does
       not guarantee that any userland job runs before loginwindow accepts
       input. The login-window pre-applicability of the layout is therefore
       a best-effort property of the helper, not a guaranteed invariant.
       See ADR-0012. -->
  <key>ProcessType</key>
  <string>Adaptive</string>
  <key>StandardOutPath</key>
  <string>/var/log/pc-setup-onishi.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/pc-setup-onishi.log</string>
</dict>
</plist>
