<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.rebuildup.pc-setup.onishi-keymap</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/pc-setup/macos-keyboard/apply-onishi.sh</string>
  </array>
  <key>UserName</key>
  <string>root</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- The helper runs for the life of the job because the Karabiner DriverKit
       virtual keyboard restores the Onishi mapping every time Kanata restarts.
       KeepAlive restarts it only after a failure so a successful exit does not
       create a restart loop. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ONISHI_WATCH_INTERVAL</key>
    <string>5</string>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/var/log/pc-setup-onishi.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/pc-setup-onishi.log</string>
</dict>
</plist>
